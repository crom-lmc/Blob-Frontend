# 生产构建配置（vite build --mode production 生效）

# 后端接口源：留空 = 与当前站点同源，由 nginx 把 /api、/uploads 反代到后端 8080。
# 不要填 IP/域名，否则地址会被写死进构建产物，换域名或上 HTTPS 都得重新构建。
VITE_API_TARGET=

# 前台站点地址：后台「查看前台」、仪表盘「查看文章」、主题编辑器 iframe 预览都跳这里。
# 必须与后台不同源，所以只能显式配置；且要与后台同协议（https），否则 iframe 会被浏览器按混合内容拦截。
VITE_WEB_ORIGIN=https://blogfrontend.laimengchao.site

# 生产不启用内置 Mock
VITE_USE_MOCK=false
